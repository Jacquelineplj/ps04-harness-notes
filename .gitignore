# Virtual environment and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Large original media downloads stay outside Git (see SUBMISSION.md for retrieval)
data/media/

# Local secrets must never be committed
.env
*.key

# Local tool settings and SQLite journal files
.claude/
*.sqlite-wal
*.sqlite-shm

# Rendered videos and OAuth tokens never go into Git
*.mp4
youtube_token.json
client_secret*.json

# Locally rendered technical walkthrough intermediates
demo/rendered/
